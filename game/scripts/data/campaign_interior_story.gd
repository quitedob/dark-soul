static func apply(config: Dictionary, level_id: String) -> Dictionary:
	var result: Dictionary = config.duplicate(true)
	if not STORIES.has(level_id):
		return result
	var story: Dictionary = STORIES[level_id]
	var stages: Array = result.get("stages", [])
	if stages.size() != 3:
		push_error("Interior story requires three configured stages: " + level_id)
		return result
	var rows: Array = story["stages"]
	for index in 3:
		# Keep props, transforms, and future caller fields from the deep copy.
		var stage: Dictionary = stages[index]
		var row: Array = rows[index]
		stage["room"] = String(row[0])
		stage["clue"] = String(row[1])
		var options: Array = row[2]
		stage["options"] = options.duplicate()
		stage["correct"] = int(row[3])
		if ROOM_PARTS.has(level_id): stage["parts"] = ROOM_PARTS[level_id].duplicate()
		stages[index] = stage
	result["title"] = String(story["title"])
	result["completion_text"] = String(story["completion_text"])
	result["stages"] = stages
	return result
